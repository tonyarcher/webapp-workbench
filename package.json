{
  "name": "webapp-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "Sandbox of small web apps: baseball tracker, rss-reader, stock-game, lemmy-vertical-scroll, clipstack, calendar-sync, radio-station, football, fitness, accounts.",
  "workspaces": [
    "apps/*",
    "apps/stock-game/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint apps packages --disable-nested-config && npm run lint --workspaces --if-present",
    "dev:baseball": "npm run dev -w baseball-tracker",
    "dev:rss-reader": "npm run dev -w rss-reader",
    "dev:rss-api": "npm run dev -w rss-api",
    "dev:stock-game": "npm run dev -w stock-game",
    "dev:lemmy": "npm run dev -w lemmy-vertical-scroll",
    "dev:clipstack": "npm run dev -w clipstack",
    "dev:calendar-sync": "npm run dev -w calendar-sync",
    "dev:radio-station": "npm run dev -w radio-station",
    "dev:radio-api": "npm run dev:server -w radio-station",
    "dev:football": "npm run dev -w football",
    "dev:fitness": "npm run dev -w fitness",
    "dev:fitness-api": "npm run dev -w fitness-api",
    "dev:stock-game-api": "npm run dev -w stock-game-api",
    "dev:user-web": "npm run dev -w user-web",
    "dev:user-api": "npm run dev -w user-api",
    "deploy": "node scripts/deploy.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\""
  },
  "devDependencies": {
    "@ttsc/graph": "^0.30.0",
    "oxlint": "^1.75.0",
    "ttsc": "^0.30.0",
    "typescript": "~6.0.2"
  }
}
