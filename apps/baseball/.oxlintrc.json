// The wtr suite in test/ asserts with chai's property-style calls
// (`expect(x).to.be.true`), which read as unused expressions. They are the
// assertions, not dead code, so the rule is off for test/ only. Scoped rather
// than app-wide: the deleted package's AGENTS.md said not to "fix" these, but
// that file is gone, and an agent that has not read the Testing section of
// AGENTS.md would otherwise "fix" them and delete real assertions.
{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "oxc"],
    "overrides": [
        {
            "files": ["test/**/*.ts"],
            "rules": {
                "eslint/no-unused-expressions": "off"
            }
        }
    ]
}
