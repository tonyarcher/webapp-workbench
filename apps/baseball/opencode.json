{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "small_model": "opencode/deepseek-v4-flash-free",
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "opencode-go/gpt-5.6-luna",
      "variant": "high",
      "description": "Master Controller and Planning Agent",
      "permission": {
        "edit": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "model": "opencode/deepseek-v4-flash-free",
      "variant": "high",
      "temperature": 0.3,
      "description": "Primary Execution and Coding Agent"
    },
    "general": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "variant": "high",
      "temperature": 0.4,
      "description": "Concurrent multi-step coding and background executor"
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "variant": "high",
      "temperature": 0,
      "description": "Fast read-only codebase explorer"
    }
  }
}