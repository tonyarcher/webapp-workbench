{
    "name": "baseball-tracker",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "oxlint",
        "test:unit": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "npm run build:components && playwright test",
        "build:components": "npm run build --prefix ../../packages/web-components",
        "test": "npm run test:unit"
    },
    "dependencies": {
        "@baseball/web-components": "*",
        "@tanstack/history": "1.162.4",
        "@tanstack/query-core": "^5.103.2",
        "@tanstack/virtual-core": "^3.17.11",
        "idb": "^8.0.3",
        "lit": "^3.3.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/node": "^26.6.2",
        "@vitest/coverage-v8": "^5.0.1",
        "fake-indexeddb": "^6.2.5",
        "oxlint": "^1.85.0",
        "typescript": "7.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    }
}
