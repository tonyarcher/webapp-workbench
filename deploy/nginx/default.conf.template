# Reverse-proxy gateway for the Baseball deployment.
# This template renders to default.conf on every deploy run;
# edit this file, never the rendered output.
# - `/` serves a hello-world page from the hello volume.
# - `/baseball/`, `/rss-reader/`, `/lemmy-vertical-scroll/`,
#   `/clipstack/`, `/calendar-sync/`, `/radio-station/`, `/football/`, `/basketball/`, `/fitness/`,
#   and `/auth/` proxy to the matching app services with the prefix stripped
#   (static nginx apps). `/user-api/` is the identity API (prefix stripped).
#   `/git/` is Gitea git + wiki (prefix stripped; ROOT_URL carries the public subpath).
#   `/tiktok-scroll/` 301s to `/clipstack/`.
# - `/stock-game/` proxies to the static Stock Game SPA with the prefix stripped,
#   like the other static apps. `/stock-game/api/` is the stock-game-api
#   (prefix stripped).
#   Each service listens on port 3000 and is resolved at runtime via Docker
#   DNS (resolver + variable proxy_pass) so the gateway recovers after a
#   container recreation within the 30s DNS TTL.

# Map the Upgrade header to a connection value: send "upgrade" when the client
# requests it, otherwise close the connection. Used to pass WebSocket upgrades
# through to the proxy locations below.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# One JSON object per line, so a shipper parses it without a regex and a
# log query can filter on fields instead of substring-matching a line.
#
# The upstream timings are the point. A 502 only ever raises one question -- was
# the connect refused, or was the upstream slow -- and the stock `combined`
# format cannot answer it. `upstream_status` and the two timings can, and
# `request_id` joins the line to the API's own JSON log for the same call.
log_format app_json escape=json
    '{'
    '"ts":"$time_iso8601",'
    # VictoriaLogs and the Grafana logs panel both read msg as the line to show.
    # Without it every gateway row renders as "missing _msg field", and `service`
    # is what makes the gateway line comparable with an API's own JSON log.
    '"msg":"request",'
    '"service":"gateway",'
    '"remote_addr":"$remote_addr",'
    '"method":"$request_method",'
    '"path":"$uri",'
    '"query":"$query_string",'
    '"status":$status,'
    '"bytes_sent":$body_bytes_sent,'
    '"request_time":$request_time,'
    '"upstream":"$upstream_addr",'
    '"upstream_status":"$upstream_status",'
    '"upstream_connect_time":"$upstream_connect_time",'
    '"upstream_header_time":"$upstream_header_time",'
    '"upstream_response_time":"$upstream_response_time",'
    '"request_id":"$request_id",'
    '"referer":"$http_referer",'
    '"ua":"$http_user_agent"'
    '}';

@@TLS_REDIRECT@@
server {
@@HTTP_LISTEN@@
@@TLS_LISTEN@@
    server_name _;
    server_tokens off;

    # stdout/stderr, not a file in the image. A file is destroyed the moment the
    # container is recreated, which is exactly when you need the log: during the
    # deploy that caused the outage.
    access_log /dev/stdout app_json;
    error_log /dev/stderr warn;

    # Defense-in-depth security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
@@TLS_CERTS@@

    resolver 127.0.0.11 valid=30s ipv6=off;

    # Hello-world page at the gateway root
    location = / {
        root /usr/share/nginx/hello;
        try_files /index.html =404;
    }

    location = /favicon.svg {
        root /usr/share/nginx/hello;
        add_header Cache-Control "no-cache";
        try_files /favicon.svg =404;
    }

    location = /favicon.ico {
        return 301 /favicon.svg;
    }

    # Redirect `/baseball` to the trailing-slash form
    location = /baseball {
        return 301 /baseball/$is_args$args;
    }

    # Baseball SPA (prefix stripped). Resolved at runtime via Docker DNS so the
    # gateway survives baseball container recreation without a reload.
    location /baseball/ {
        set $upstream_baseball http://baseball:3000;
        rewrite ^/baseball/(.*)$ /$1 break;
        proxy_pass $upstream_baseball;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    # Redirect the bare paths to their trailing-slash forms so relative assets
    # and route links resolve under each subpath.
    location = /stock-game {
        return 301 /stock-game/$is_args$args;
    }

    location = /lemmy-vertical-scroll {
        return 301 /lemmy-vertical-scroll/$is_args$args;
    }

    location = /clipstack {
        return 301 /clipstack/$is_args$args;
    }

    location = /calendar-sync {
        return 301 /calendar-sync/$is_args$args;
    }

    location = /tiktok-scroll {
        return 301 /clipstack/$is_args$args;
    }

    location = /rss-reader {
        return 301 /rss-reader/$is_args$args;
    }

    location = /radio-station {
        return 301 /radio-station/$is_args$args;
    }

    location = /football {
        return 301 /football/$is_args$args;
    }

    location = /basketball {
        return 301 /basketball/$is_args$args;
    }

    location = /fitness {
        return 301 /fitness/$is_args$args;
    }

    location = /auth {
        return 301 /auth/$is_args$args;
    }

    location = /git {
        return 301 /git/$is_args$args;
    }

    # RSS reader API (prefix stripped): JSON + poller backend. Must match
    # before the general /rss-reader/ static location below.
    location ^~ /rss-reader/api/ {
        set $upstream_rss_api http://rss-api:3000;
        rewrite ^/rss-reader/api/(.*)$ /$1 break;
        proxy_pass $upstream_rss_api;
        proxy_http_version 1.1;
        # Server AI summarization can take a full model generation.
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /stock-game/ {
        set $upstream_stock_game http://stock-game:3000;
        rewrite ^/stock-game/(.*)$ /$1 break;
        proxy_pass $upstream_stock_game;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location ^~ /stock-game/api/ {
        set $upstream_stock_game_api http://stock-game-api:3000;
        rewrite ^/stock-game/api/(.*)$ /$1 break;
        proxy_pass $upstream_stock_game_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /lemmy-vertical-scroll/ {
        set $upstream_lemmy_vertical_scroll http://lemmy-vertical-scroll:3000;
        rewrite ^/lemmy-vertical-scroll/(.*)$ /$1 break;
        proxy_pass $upstream_lemmy_vertical_scroll;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /tiktok-scroll/ {
        rewrite ^/tiktok-scroll/(.*)$ /clipstack/$1 permanent;
    }

    location /clipstack/ {
        set $upstream_clipstack http://clipstack:3000;
        rewrite ^/clipstack/(.*)$ /$1 break;
        proxy_pass $upstream_clipstack;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /calendar-sync/ {
        set $upstream_calendar_sync http://calendar-sync:3000;
        rewrite ^/calendar-sync/(.*)$ /$1 break;
        proxy_pass $upstream_calendar_sync;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location ^~ /radio-station/api/ {
        set $upstream_radio_api http://radio-api:3000;
        rewrite ^/radio-station/api/(.*)$ /$1 break;
        proxy_pass $upstream_radio_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location ^~ /fitness/api/ {
        set $upstream_fitness_api http://fitness-api:3000;
        rewrite ^/fitness/api/(.*)$ /$1 break;
        proxy_pass $upstream_fitness_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    # Log viewer (Grafana over VictoriaLogs). Same shape as the other apps:
    # prefix stripped, resolved through Docker DNS. Grafana is told its root_url
    # in compose so its own asset URLs match this prefix.
    location ^~ /logs/ {
        set $upstream_logs http://grafana:3000;
        # No prefix rewrite, unlike every other app here. Grafana runs with
        # serve_from_sub_path, so it expects the full /logs/... path and strips
        # the prefix itself. Stripping it here makes Grafana answer a redirect
        # to /logs/, which the gateway maps back to / -- an endless 301 loop.
        proxy_pass $upstream_logs;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location ^~ /user-api/ {
        set $upstream_user_api http://user-api:3000;
        rewrite ^/user-api/(.*)$ /$1 break;
        proxy_pass $upstream_user_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /fitness/ {
        set $upstream_fitness http://fitness:3000;
        rewrite ^/fitness/(.*)$ /$1 break;
        proxy_pass $upstream_fitness;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /football/ {
        set $upstream_football http://football:3000;
        rewrite ^/football/(.*)$ /$1 break;
        proxy_pass $upstream_football;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /basketball/ {
        set $upstream_basketball http://basketball:3000;
        rewrite ^/basketball/(.*)$ /$1 break;
        proxy_pass $upstream_basketball;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /radio-station/ {
        set $upstream_radio_station http://radio-station:3000;
        rewrite ^/radio-station/(.*)$ /$1 break;
        proxy_pass $upstream_radio_station;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /rss-reader/ {
        set $upstream_rss_reader http://rss-reader:3000;
        rewrite ^/rss-reader/(.*)$ /$1 break;
        proxy_pass $upstream_rss_reader;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /auth/ {
        set $upstream_user_web http://user-web:3000;
        rewrite ^/auth/(.*)$ /$1 break;
        proxy_pass $upstream_user_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    # Gitea git + wiki (prefix stripped, like the other apps). Per the Gitea
    # sub-path docs the proxy passes /git/foo as /foo; ROOT_URL still carries
    # the public /git/ subpath for links. SSH bypasses the gateway on the
    # mapped host port (VPN only).
    location /git/ {
        set $upstream_gitea http://gitea:3000;
        rewrite ^/git/(.*)$ /$1 break;
        proxy_pass $upstream_gitea;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        client_max_body_size 512m;
    }
}
