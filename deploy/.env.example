# Deployment environment. Copy to deploy/.env for production overrides.
# Compose keeps rss/rss fallbacks so local zero-config still works.

POSTGRES_USER=rss
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_DB=rss

# --- Server AI summarization (optional) ---
# Empty AI_PROVIDER disables the /ai routes' backend and the reader hides
# every server option. Set AI_PROVIDER=ollama|opencode with AI_API_URL and
# AI_MODEL to enable. Model credentials (AI_API_USER/AI_API_PASSWORD) live
# only in the untracked deploy/.env, never here and never in an image.
# Front-page Jev ranking uses AI_PROVIDER=jev with a TypeSafe key instead
# (AI_API_URL/AI_MODEL stay empty; base and model default to
# https://api.typesafe.ai and jev-latest). The key likewise lives only in
# the untracked deploy/.env.
# AI_PROVIDER=
# AI_API_URL=http://ollama:11434
# AI_MODEL=qwen3:8b
# TYPESAFE_API_KEY=
# Jev attempts count against AI_HOURLY_LIMIT/AI_DAILY_LIMIT even when the batch fails.

# --- HTTPS (LAN and cloud) ---
# Hostnames for the gateway TLS cert (comma/space separated). Empty = plain
# HTTP only, exactly like today. Use a hostname, never a bare IP: browsers
# reject IPs for passkeys (IP SANs would still encrypt fine, but passkeys
# need a registrable hostname).
#   LAN:   TLS_HOSTS=workbench.lan   (+ a hosts-file entry pointing at the host)
#   Cloud: TLS_HOSTS=app.example.com (plus real DNS; provide certs below)
# TLS_HOSTS=
# Redirect plain HTTP to HTTPS once TLS is on (0/1).
TLS_REDIRECT=0

# --- Log pipeline (Alloy -> VictoriaLogs -> Grafana) ---
# Shared secret for Grafana's OAuth client against user-api. Required: compose
# refuses to render the file without it, because an empty secret starts Grafana
# with working-looking screens that nobody can sign in to.
GRAFANA_OAUTH_SECRET=replace_me
# Where the browser reaches user-api, e.g. https://workbench.lan/user-api. Grafana
# sends the BROWSER here, so it must be the public origin and not localhost.
# This is not OAUTH_ISSUER, which is the value user-api signs into tokens and
# keeps origin-independent. Must match a redirect_uri row for client 'grafana'.
# GRAFANA_OAUTH_ISSUER=https://workbench.lan/user-api
# Public Grafana URL, prefix included. The gateway serves it at /logs/.
# GRAFANA_ROOT_URL=https://workbench.lan/logs/
# How long the pipeline keeps logs. The default in compose is 30d.
LOG_RETENTION=30d
# Provided certs (cloud/LE) instead of the generated local CA: paths on this
# machine to a PEM cert and key. Leave unset for the local-CA flow.
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# Delete the leaf (or set TLS_FORCE=1) to rotate.
#
# Identity must match the origin you browse. user-api signs OAUTH_ISSUER
# (independent of your host); the rows below name YOUR host:
# WEBAUTHN_RP_ID=workbench.lan
# WEBAUTHN_ORIGINS=https://workbench.lan
# ...plus an oauth_redirect_uris row per app origin, e.g.:
# INSERT INTO oauth_redirect_uris (client_id, redirect_uri)
#   VALUES ('rss-reader', 'https://workbench.lan/rss-reader/') ON CONFLICT DO NOTHING;

# --- Gitea git + wiki (behind the gateway at /git/, SSH via VPN) ---
# Public web URL must end with /git/. The gateway strips /git/ before proxying
# (per the Gitea sub-path docs); Gitea itself serves from its root.
# GITEA_ROOT_URL=https://workbench.lan/git/
# Host Gitea shows in clone URLs (VPN address or hostname clients use).
# GITEA_SSH_DOMAIN=10.13.13.1
# SSH bind and port (host -> gitea 22). Default binds localhost only; set
# GITEA_SSH_BIND to the VPN address (e.g. 10.13.13.1) or 0.0.0.0 behind a
# firewall so VPN clients can reach it. The advertised port follows the mapping.
# GITEA_SSH_BIND=10.13.13.1
# GITEA_SSH_PORT=2222
# --- Gitea signing in with user-api ---
# Gitea's OpenID Connect source signs in with the same identity as every other
# app, so a forge account and an accounts account are the same person. The
# client is registered by migration (oauth_clients / oauth_redirect_uris); only
# the secret lives here.
# GITEA_OAUTH_SECRET=replace_me
# Gitea is told to auto-discover user-api at the PUBLIC base, then it redirects
# the browser to the authorize endpoint and calls the rest of the endpoints
# server-side over the compose network.
# GITEA_OAUTH_ISSUER=https://workbench.lan/user-api
# --- user-api OIDC discovery ---
# The discovery document publishes two bases, because a browser and a container
# reach this service by different names. OAUTH_PUBLIC_BASE is what the browser
# follows to /oauth/authorize and must include the gateway prefix;
# OAUTH_INTERNAL_BASE is what client processes call for token, userinfo and
# jwks, from inside the compose network. Setting them the same breaks the
# server-to-server calls, which is why compose does not default them together.
# OAUTH_PUBLIC_BASE=https://workbench.lan/user-api
# OAUTH_INTERNAL_BASE=http://user-api:3000
# Clients that may complete a flow WITHOUT PKCE, as `client_id=sha256hex` pairs.
# A client listed here is confidential: it authenticates at the token endpoint
# instead, and a code issued to it without PKCE is only redeemable by a caller
# that presents the matching secret. Everyone else is public and must use PKCE.
# Gitea is listed because it cannot send PKCE -- the fix is go-gitea/gitea#38202,
# still an unmerged PR -- and PKCE guards PUBLIC clients, while a client with a
# secret is bound by the secret.
#   python -c "import hashlib,sys;print(hashlib.sha256(open('deploy/.env').read()
#     .split('GITEA_OAUTH_SECRET=')[1].split()[0].encode()).hexdigest())"
# OAUTH_CLIENT_SECRETS=gitea=<64 hex sha256 of GITEA_OAUTH_SECRET>
# Gitea uses the shared postgres instance with its own `gitea` database.
# Fresh volumes create it via the baked-in deploy/postgres/initdb/10-gitea.sql.
# Existing volumes need one manual step after postgres is up (uses your POSTGRES_USER):
#   docker compose -f deploy/docker-compose.yml exec postgres psql -U ${POSTGRES_USER:-rss} -d postgres -c "SELECT 'CREATE DATABASE gitea' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'gitea')\gexec"
