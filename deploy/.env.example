# Deployment environment. Copy to deploy/.env for production overrides.
# Compose keeps rss/rss fallbacks so local zero-config still works.

POSTGRES_USER=rss
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_DB=rss

# --- HTTPS (LAN and cloud) ---
# Hostnames for the gateway TLS cert (comma/space separated). Empty = plain
# HTTP only, exactly like today. Use a hostname, never a bare IP: browsers
# reject IPs for passkeys (IP SANs would still encrypt fine, but passkeys
# need a registrable hostname).
#   LAN:   TLS_HOSTS=workbench.lan   (+ a hosts-file entry pointing at the host)
#   Cloud: TLS_HOSTS=app.example.com (plus real DNS; provide certs below)
# TLS_HOSTS=
# Redirect plain HTTP to HTTPS once TLS is on (0/1).
TLS_REDIRECT=0
# Provided certs (cloud/LE) instead of the generated local CA: paths on this
# machine to a PEM cert and key. Leave unset for the local-CA flow.
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# Delete the leaf (or set TLS_FORCE=1) to rotate.
#
# Identity must match the origin you browse. user-api signs OAUTH_ISSUER
# (independent of your host); the rows below name YOUR host:
# WEBAUTHN_RP_ID=workbench.lan
# WEBAUTHN_ORIGINS=https://workbench.lan
# ...plus an oauth_redirect_uris row per app origin, e.g.:
# INSERT INTO oauth_redirect_uris (client_id, redirect_uri)
#   VALUES ('rss-reader', 'https://workbench.lan/rss-reader/') ON CONFLICT DO NOTHING;
