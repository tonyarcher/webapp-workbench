{
    "name": "football-core",
    "version": "0.1.0",
    "type": "module",
    "description": "Football types, pluggable rulebooks, play-by-play reducer, clock, and notation.",
    "license": "MIT",
    "files": [
        "dist"
    ],
    "main": "./dist/football-core.js",
    "module": "./dist/football-core.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/football-core.js"
        }
    },
    "scripts": {
        "build": "vite build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "prepare": "npm run build"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^5.0.1",
        "typescript": "7.0.2",
        "vite": "^8.3.0",
        "vite-plugin-dts": "^5.1.1",
        "vitest": "^5.0.1"
    }
}
