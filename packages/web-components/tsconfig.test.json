// Typechecks the test suite, which the build tsconfig deliberately leaves out.
// Its include is src only, and wtr runs esbuild, which strips types without
// checking them, so errors in test/ used to reach a commit with every gate green.
//
// Extends the build config so the strict flags stay identical, and turns the two
// settings off that cannot apply together: the tests import with .ts specifiers,
// which needs allowImportingTsExtensions, and that in turn needs noEmit.
{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["node", "mocha"],
        "allowImportingTsExtensions": true,
        "noEmit": true
    },
    "include": ["src/**/*", "test/**/*"]
}
