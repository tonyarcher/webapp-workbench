{
    "name": "basketball-core",
    "version": "0.1.0",
    "type": "module",
    "description": "Basketball types, pluggable rulebooks, court geometry, shot clock, and play reducer.",
    "license": "MIT",
    "files": [
        "dist"
    ],
    "main": "./dist/basketball-core.js",
    "module": "./dist/basketball-core.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/basketball-core.js"
        }
    },
    "scripts": {
        "build": "vite build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "prepare": "npm run build"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.11",
        "typescript": "7.0.2",
        "vite": "^8.2.0",
        "vite-plugin-dts": "^5.0.3",
        "vitest": "^4.1.11"
    }
}
