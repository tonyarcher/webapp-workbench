# Handle text files automatically and normalize them to Unix-style LF in the repository
* text=auto
.gitattributes text eol=lf

# Explicitly force LF line endings for text-based files on checkout
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf

# Explicitly force CRLF line endings for Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf