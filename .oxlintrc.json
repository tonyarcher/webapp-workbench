{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-server/**",
    "**/.output/**",
    "**/coverage/**",
    "**/data/**",
    "**/public/**",
    "**/*.gen.ts",
    "apps/stock-game/**"
  ],
  "rules": {
    "max-lines": [
      "error",
      {
        "max": 500,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 30,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "complexity": ["error", 10]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "**/scripts/**", "**/e2e/**"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "complexity": "off"
      }
    }
  ]
}
