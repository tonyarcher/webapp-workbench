# Dependencies
node_modules/

# Build output
dist/
coverage/
test-results/
playwright-report/
*.tsbuildinfo

# Editor / tooling
.idea/
.vscode/
.air/
.cursor/
.gemini/

# Environment
.env
.env.*
!.env.example

# Logs
*.log

# Editor backups
*~

# Gateway TLS: generated per-host certs. Never commit keys.
deploy/gateway/certs/*
!deploy/gateway/certs/.gitkeep
# Gateway nginx: rendered from default.conf.template on every deploy.
deploy/nginx/default.conf
# Database dumps taken before a major-version upgrade. These are local backups
# of real data, hundreds of megabytes, and must never reach the repository.
deploy/*.dump
deploy/*.dump.*

# Gradle / Kotlin
.gradle/
.kotlin/
# The wrapper is committed, so a fresh clone and CI use the same Gradle version
# without relying on whichever Gradle a machine or runner image happens to ship.
# Root Gradle report dir (root build.gradle.kts only; nested apps/*/api/build/ ignored below)
/build/
buildSrc/build/
buildSrc/.gradle/
apps/user/api/build/
apps/user/api/.kotlin/
apps/fitness/api/build/
apps/fitness/api/.kotlin/
apps/rss/api/build/
apps/rss/api/.kotlin/
apps/stock-game/api/build/
apps/stock-game/api/.kotlin/
apps/radio-station/api/build/
apps/radio-station/api/.kotlin/

# Python
__pycache__/
*.pyc
