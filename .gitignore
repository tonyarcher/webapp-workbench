# Dependencies
node_modules/

# Build output
dist/
coverage/
test-results/
playwright-report/
*.tsbuildinfo

# Editor / tooling
.idea/
.vscode/
.air/
.cursor/
.gemini/

# Environment
.env
.env.*
!.env.example

# Logs
*.log

# Editor backups
*~

# Gateway TLS: generated per-host certs. Never commit keys.
deploy/gateway/certs/*
!deploy/gateway/certs/.gitkeep
# Gateway nginx: rendered from default.conf.template on every deploy.
deploy/nginx/default.conf

# Gradle / Kotlin
.gradle/
.kotlin/
# The wrapper is local-only (generated by `gradle wrapper`); never commit it.
gradlew
gradlew.bat
/gradle/
gradle/wrapper/gradle-wrapper.jar
# Root Gradle report dir (root build.gradle.kts only; nested apps/*/api/build/ ignored below)
/build/
apps/user/api/build/
apps/user/api/.kotlin/
apps/fitness/api/build/
apps/fitness/api/.kotlin/
apps/rss/api/build/
apps/rss/api/.kotlin/
apps/stock-game/api/build/
apps/stock-game/api/.kotlin/

# Python
__pycache__/
*.pyc
